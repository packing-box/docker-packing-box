#!/bin/bash
# Compute success/failure statistics from the verbose setup logs of items (i.e. 'packing-box -v setup [item-class]').
#  Each item is ranked according to the worst log level met while setting it up:
#   - failed:  CRITICAL (an exception was raised or the result of the last install command does not exist)
#   - error:   ERROR (stderr of an install command not recognized as a warning)
#   - warning: WARNING only
#   - ok:      none of the above
#  Note that stderr is classified on its wording, not on the exit codes of the install commands.
# usage: setup-stats setup-detector.log [setup-packer.log ...]
if [ $# -eq 0 ]; then
  echo "usage: $(basename "$0") setup-[item-class].log [...]" >&2
  exit 1
fi
for LOG in "$@"; do
  CLASS=$(basename "$LOG" .log); CLASS=${CLASS#setup-}
  awk -v class="$CLASS" '
    match($0, /\[(DEBUG|INFO|WARNING|ERROR|CRITICAL) *\] +[^ ]+ +/) {
      hdr = substr($0, RSTART, RLENGTH); msg = substr($0, RSTART + RLENGTH)
      split(hdr, h, /[][ ]+/); lvl = h[2]; name = h[3]
      if (msg ~ /^Setting up /) { cur = name; order[++n] = cur; st[cur] = "ok"; next }
      if (msg ~ /^Skipping /)   { order[++n] = name; st[name] = "skipped"; next }
      if (cur == "") next
      if (lvl == "CRITICAL")                            { st[cur] = "failed"; why[cur] = msg }
      else if (lvl == "ERROR" && st[cur] != "failed")   { st[cur] = "error"; if (!(cur in why)) why[cur] = msg }
      else if (lvl == "WARNING" && st[cur] == "ok")     { st[cur] = "warning"; why[cur] = msg }
    }
    END {
      for (i = 1; i <= n; i++) { k = order[i]; c[st[k]]++ }
      tot = n - c["skipped"]
      printf "== %s: %d set up, %d skipped\n", class, tot, c["skipped"]
      split("ok warning error failed", L, " ")
      for (j = 1; j <= 4; j++) printf "   %-8s %3d (%5.1f%%)\n", L[j], c[L[j]], tot ? 100 * c[L[j]] / tot : 0
      for (i = 1; i <= n; i++) { k = order[i]; if (st[k] ~ /error|failed/) printf "   - %-20s %-7s %s\n", k, st[k], substr(why[k], 1, 90) }
    }' "$LOG"
done
