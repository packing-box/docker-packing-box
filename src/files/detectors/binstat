#!/usr/bin/env python3
# -*- coding: UTF-8 -*-
from binstat import BinStat, MODELS
from binstat.__info__ import __author__, __license__, __source__, __version__
from pboxtools import *


ARGS = [
    [("-m", "--model"), {'choices': MODELS, 'help': "path to a JSON model, or name of a shipped model "
                                                   f"({', '.join(MODELS)})"}],
    [("-t", "--threshold"), {'default': .5, 'type': float,
                             'help': "minimum ratio of packed blocks for the executable to be packed"}],
]


@version("BinStat %s <%s> by %s\nLicensed under %s" % (__version__, __source__, __author__, __license__))
@catch_exception
def execute(name, **kwargs):
    kwargs['orig_args']['logger'] = kwargs['logger']
    return str(BinStat(**kwargs['orig_args']).detect(kwargs['path']))


def parse(output, **kwargs):
    return output.splitlines()[-1]


if __name__ == "__main__":
    run("BinStat", exec_func=execute, parse_func=parse, binary_only=True, parser_args=ARGS)

